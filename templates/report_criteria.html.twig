{# Export form of the "spent time by group" reports: the posted criteria are posted again with
   the chosen output format. Only the formats the reports produce are offered (Tool::show*()
   buffers CSV, ODS and XLSX); a negative value exports every page. #}
<div class="card mt-3">
    <div class="card-header">
        <h3 class="card-title">{{ title }}</h3>
    </div>
    <div class="card-body">
        <form method="post" action="{{ action }}" class="d-flex flex-wrap align-items-center gap-2">
            {% for field in hidden %}
                <input type="hidden" name="{{ field.name }}" value="{{ field.value }}">
            {% endfor %}
            {{ call('Dropdown::showFromArray', ['display_type', output_formats, {display: false, width: 'auto'}])|raw }}
            <button type="submit" name="export" class="btn btn-outline-secondary" title="{{ _x('button', 'Export') }}">
                <i class="ti ti-device-floppy me-1"></i>{{ _x('button', 'Export') }}
            </button>
        </form>
    </div>
</div>
