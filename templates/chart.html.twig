{#
 # Timeline chart of a ticket (Display::showTimelineGraph()), drawn by
 # public/js/timeline_chart.js with the ECharts library of GLPI. The data travel as JSON in an
 # attribute, escaped by Twig: no inline script, no label reaching a script context.
 #
 # Expected context:
 #  - chart:       {rows: row labels, periods: [{row, begin, end, duration}]}
 #  - echarts_src: URL of the ECharts library of GLPI
 #}
<div class="tt-chart" data-tt-chart="{{ chart|json_encode }}" data-tt-echarts-src="{{ echarts_src }}"
     role="img" aria-label="{{ _n('Timeline of ticket', 'Timeline of tickets', 1, 'timelineticket') }}"></div>
