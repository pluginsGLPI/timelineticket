{#
 # The chart markup is entirely generated by the Google Charts service: it contains no
 # user supplied value except the row labels, and the angle brackets of the serialised
 # payload are escaped as \u003C / \u003E by Display::hardenChartPayload() before it
 # here, so no label can close the generated <script> block. Escaping the markup itself
 # would break that block, so |raw is required.
 #}
<div class="tt-chart" style="width:100%">
    {{ chart|raw }}
    <div class="alert alert-warning tt-chart-fallback" role="alert">
        {{ __('The chart could not be drawn: the Google Charts modules could not be loaded from www.gstatic.com. Check the outbound access and the content security policy of this instance.', 'timelineticket') }}
    </div>
</div>
