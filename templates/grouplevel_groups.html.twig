{% if groups is not empty %}
    <table class="tab_cadre_fixe" cellpadding="5">
        {% for group in groups %}
            <tr class="tab_bg_1 center">
                {# group.name auto-escaped by Twig (raw DB value from getDropdownName) #}
                <td>{{ group.name }}</td>
                <td>
                    <form method="post" action="{{ form_url }}">
                        <input type="hidden" name="delete_groups" value="delete_groups">
                        <input type="hidden" name="id" value="{{ id }}">
                        <input type="hidden" name="_groups_id_assign" value="{{ group.id }}">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                title="{{ _x('button', 'Delete permanently') }}">
                            <i class="ti ti-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
        {% endfor %}
    </table>
{% else %}
    {{ __('None') }}
{% endif %}
