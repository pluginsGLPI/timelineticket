<table class="table table-bordered text-center rounded">
    {% if rows is empty %}
        <tr class="bg-body-tertiary"><td>{{ __('No results found') }}</td></tr>
    {% else %}
        <tr class="bg-body-tertiary">
            <th colspan="5">{{ __('Result details') }} ({{ __('Statuses', 'timelineticket') }})</th>
        </tr>
        <tr>
            {# GLPI/Google Charts generated markup, safe to output as-is #}
            <td colspan="5" style="width:100%">{{ chart|raw }}</td>
        </tr>
        <tr class="bg-body-tertiary">
            <th>{{ __('Old status', 'timelineticket') }}</th>
            <th>{{ __('New status', 'timelineticket') }}</th>
            <th>{{ __('Begin date') }}</th>
            <th>{{ __('End date') }}</th>
            <th class="right">{{ __('Delay', 'timelineticket') }}</th>
        </tr>
        {% for row in rows %}
            <tr>
                <td>{{ row.old_status }}</td>
                <td>{{ row.new_status }}</td>
                <td>{{ row.begin_date }}</td>
                <td>{{ row.end_date }}</td>
                <td class="right">{{ row.delay }}</td>
            </tr>
        {% endfor %}
    {% endif %}
</table>
