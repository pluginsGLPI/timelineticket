{# Result table of the "spent time by group" reports (report/*/stat*ByGroup.php), filled by the
   Tool::show*() wrappers. The cells are pre-escaped by the reports (Tool::escapeForOutput(),
   the core getLink()/convDateTime() helpers): they are output raw. #}
<div class="card mt-3">
    <div class="table-responsive">
        <table class="table card-table table-hover table-sm">
            <thead>
                <tr>
                    {% for col in cols %}
                        <th class="text-nowrap{% if col.sorted %} order_{{ col.order }}{% endif %}">
                            {% if col.link is not empty %}
                                <a href="{{ col.link }}">{{ col.label|raw }}</a>
                            {% else %}
                                {{ col.label|raw }}
                            {% endif %}
                        </th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr>
                        {% for cell in row %}
                            <td class="align-top">{{ cell|raw }}</td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
