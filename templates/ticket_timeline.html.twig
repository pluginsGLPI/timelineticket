<div class="card">
    <div class="card-header">
        <h4 class="card-title d-flex align-items-center">
            <i class="{{ icon }} me-2 text-danger"></i>{{ _n('Timeline of ticket', 'Timeline of tickets', 1, 'timelineticket') }}
        </h4>
        <small class="text-muted d-flex align-items-center ms-auto">
            {# Html::showSimpleForm() generated markup (includes CSRF token), safe to output #}
            {{ reconstruct_button|raw }}
        </small>
    </div>

    <div class="card-header">
        <div class="mb-3 d-flex flex-wrap gap-2">
            {{ __('Used calendar', 'timelineticket') }} - {{ _n('Time range', 'Time ranges', 2) }}&nbsp;:
            {# GLPI-generated calendar link markup, safe to output #}
            {{ calendar_link|raw }}
            {% if late %}
                <br><span class="red">{{ __('Late') }}&nbsp;: {{ late }}</span>
            {% endif %}
        </div>
    </div>

    <div class="alert alert-secondary">
        <i class="ti ti-info-circle"></i>&nbsp;{{ info_message }}
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <fieldset class="border p-3 mb-3 rounded">
                    <div class="row g-2">
                        {{ history|raw }}
                    </div>
                </fieldset>
            </div>
        </div>
    </div>

    <div class="card-footer d-flex justify-content-between align-items-center">
        <div class="text-muted d-flex align-items-center">
            <i class="ti ti-info-circle me-1"></i>
            <span>{{ __('Total') }}</span>
            <span class="ms-2">{{ total }}</span>
        </div>
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <fieldset class="border p-3 mb-3 rounded">
                    <div class="row g-2">
                        {{ detail_group|raw }}
                    </div>
                </fieldset>
            </div>
        </div>
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <fieldset class="border p-3 mb-3 rounded">
                    <div class="row g-2">
                        {{ detail_user|raw }}
                    </div>
                </fieldset>
            </div>
        </div>
    </div>
</div>

<div class="card-body">
    <div class="row">
        <div class="col-12">
            <div class="card-header w-auto px-2 fs-6 fw-bold">
                <i class="ti ti-layout-rows me-1"></i>{{ __('Assignment swimlane', 'timelineticket') }}
            </div>
            <div class="card-body">
                <fieldset class="border p-3 mb-3 rounded">
                    {# Swimlane markup + its coupled inline JS, generated server-side #}
                    {{ swimlane|raw }}
                </fieldset>
            </div>
        </div>
    </div>
</div>

{% if debug %}
    {% if debug_groups is not empty %}
        <br>
        <table class="table table-bordered text-center rounded">
            <tr><th class="bg-body-tertiary" colspan="5">{{ __('DEBUG') }} {{ __('Group') }}</th></tr>
            <tr class="bg-body-tertiary">
                <th>{{ __('ID') }}</th>
                <th>{{ __('Date') }}</th>
                <th>{{ __('Group') }}</th>
                <th>{{ __('Begin') }}</th>
                <th>{{ __('Delay', 'timelineticket') }}</th>
            </tr>
            {% for row in debug_groups %}
                <tr>
                    <td>{{ row.id }}</td>
                    <td>{{ row.date }}</td>
                    <td>{{ row.name }}</td>
                    <td>{{ row.begin }}</td>
                    <td>{{ row.delay }}</td>
                </tr>
            {% endfor %}
        </table>
    {% endif %}
    {% if debug_users is not empty %}
        <br>
        <table class="table table-bordered text-center rounded">
            <tr class="bg-body-tertiary"><th colspan="5">{{ __('DEBUG') }} {{ __('Technician') }}</th></tr>
            <tr class="bg-body-tertiary">
                <th>{{ __('ID') }}</th>
                <th>{{ __('Date') }}</th>
                <th>{{ __('Technician') }}</th>
                <th>{{ __('Begin') }}</th>
                <th>{{ __('Delay', 'timelineticket') }}</th>
            </tr>
            {% for row in debug_users %}
                <tr>
                    <td>{{ row.id }}</td>
                    <td>{{ row.date }}</td>
                    <td>{{ row.name }}</td>
                    <td>{{ row.begin }}</td>
                    <td>{{ row.delay }}</td>
                </tr>
            {% endfor %}
        </table>
    {% endif %}
{% endif %}
