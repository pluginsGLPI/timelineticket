<table class="table table-bordered text-center rounded">
    <tr class="bg-body-tertiary">
        <th colspan="{{ colspan }}">
            {{ __('Result details') }}{% if subtitle %} ({{ subtitle }}){% endif %}
        </th>
    </tr>
    <tr>
        {# GLPI/Google Charts generated markup, safe to output as-is #}
        <td colspan="{{ colspan }}" style="width:100%">{{ chart|raw }}</td>
    </tr>
    <tr>
        <th class="bg-body-secondary"></th>
        {% for name in statuses %}
            <th class="bg-body-tertiary">{{ name }}</th>
        {% endfor %}
    </tr>
    {% for row in rows %}
        <tr>
            {# row.label is a raw DB value (group/user name), auto-escaped by Twig #}
            <th class="bg-body-tertiary">{{ row.label }}</th>
            {% for cell in row.cells %}
                <td>{{ cell }}</td>
            {% endfor %}
        </tr>
    {% endfor %}
</table>
