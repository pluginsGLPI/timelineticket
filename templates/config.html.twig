<form method="post" action="{{ form_url }}">
    <div class="center">
        <table class="tab_cadre_fixe">
            <tr>
                <th colspan="2">{{ __('Flags', 'timelineticket') }}</th>
            </tr>
            <tr class="tab_bg_1 top">
                <td>{{ __('Input time on groups / users when ticket is waiting', 'timelineticket') }}</td>
                {# GLPI-generated dropdown markup, safe to output as-is #}
                <td>{{ add_waiting_dropdown|raw }}</td>
            </tr>
            <tr class="tab_bg_1">
                <td colspan="2">
                    <input type="hidden" name="id" value="1">
                    <button type="submit" name="update" class="btn btn-primary">
                        {{ _x('button', 'Save') }}
                    </button>
                </td>
            </tr>
        </table>
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    </div>
</form>
