{
    "require": {
        "sportlog/google-charts": "^1.0",
        "php": ">=8.2"
    },
    "require-dev": {
        "glpi-project/tools": "^0.8"
    },
    "autoload-dev": {
        "psr-4": {
            "GlpiPlugin\\Timelineticket\\Tests\\": "tests/"
        }
    },
    "config": {
        "autoloader-suffix": "PluginTimelineticket",
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.99"
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "../../vendor/bin/parallel-lint --exclude vendor --exclude node_modules .",
        "cs": "../../vendor/bin/php-cs-fixer fix --dry-run --diff --ansi",
        "cs-fix": "../../vendor/bin/php-cs-fixer fix --ansi",
        "phpstan": "../../vendor/bin/phpstan analyze --ansi --memory-limit=1G",
        "qa": [
            "@lint",
            "@phpstan",
            "@cs"
        ]
    }
}
